    `milestone_reminder_days >= 0` [name: 'ck_university_settings_reminder']
    `default_proposal_review_days > 0` [name: 'ck_university_settings_review']
    `max_active_supervisees_per_supervisor > 0` [name: 'ck_university_settings_supervisees']
