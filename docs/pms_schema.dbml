Table university_settings {
  id uuid [pk, not null, note: 'ORM default: uuid4']
  university_id uuid [not null]
  max_supervisors_per_project int [not null, note: 'ORM default: 2']
  max_active_projects_per_student int [not null, note: 'ORM default: 1']
  max_active_supervisees_per_supervisor int [not null, note: 'ORM default: 10']
  student_inactivity_days int [not null, note: 'ORM default: 30']
  milestone_reminder_days int [not null, note: 'ORM default: 7']
  default_proposal_review_days int [not null, note: 'ORM default: 14']
