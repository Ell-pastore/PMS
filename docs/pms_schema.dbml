  // PostgreSQL partial-index predicate for uq_project_supervisors_active_staff: ended_at IS NULL
  // PostgreSQL partial-index predicate for uq_project_supervisors_primary_active: assignment_role = 'primary' AND ended_at IS NULL
  indexes {
  (project_id, staff_id) [unique, name: 'uq_project_supervisors_active_staff']
  (project_id) [unique, name: 'uq_project_supervisors_primary_active']
  }
  checks {
    `ended_at IS NULL OR ended_at >= started_at` [name: 'ck_project_supervisors_dates']
    `assignment_role IN ('primary', 'co_supervisor')` [name: 'ck_project_supervisors_role']
  }
}

Table proposal_participants {
