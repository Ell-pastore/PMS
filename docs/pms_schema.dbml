Ref: account_verifications.user_id > users.id [delete: restrict]
Ref: alert_events.university_id > universities.id [delete: restrict]
Ref fk_alert_events_rule_university: alert_events.(rule_id, university_id) > alert_rules.(id, university_id) [delete: restrict]
