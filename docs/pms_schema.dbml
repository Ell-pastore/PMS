  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  // PostgreSQL partial-index predicate for uq_project_participants_active_lead: is_lead = true AND ended_at IS NULL
  // PostgreSQL partial-index predicate for uq_project_participants_active_student: ended_at IS NULL
  indexes {
  (project_id) [unique, name: 'uq_project_participants_active_lead']
  (project_id, student_id) [unique, name: 'uq_project_participants_active_student']
  }
  checks {
    `ended_at IS NULL OR ended_at >= started_at` [name: 'ck_project_participants_dates']
  }
}

Table project_status_history {
