  (id, university_id) [unique, name: 'uq_progress_reports_id_university']
  (project_id, period_start, period_end) [name: 'ix_progress_reports_project_period']
  }
  checks {
    `period_end >= period_start` [name: 'ck_progress_reports_period']
    `status IN ('draft', 'submitted', 'under_review', 'revision_requested', 'approved', 'rejected')` [name: 'ck_progress_reports_status']
  }
}

Table project_comments {
  id uuid [pk, not null, note: 'ORM default: uuid4']
  university_id uuid [not null]
  project_id uuid
  milestone_id uuid
  progress_report_id uuid
  author_id int [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [note: 'ORM onupdate: now()']
  indexes {
  (project_id, created_at) [name: 'ix_project_comments_project_created']
  }
  checks {
    `num_nonnulls(project_id, milestone_id, progress_report_id) = 1` [name: 'ck_project_comments_one_target']
  }
}

Table project_milestones {
  id uuid [pk, not null, note: 'ORM default: uuid4']
  university_id uuid [not null]
  project_id uuid [not null]
  template_id uuid
  title varchar(255) [not null]
  description text
  sequence_number int [not null]
  due_date date [not null]
  status varchar(32) [not null, default: 'pending']
  completed_at timestamptz
  created_by_id int [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'ORM onupdate: now()']
  indexes {
  (project_id, sequence_number) [unique, name: 'uq_project_milestones_sequence']
  (id, university_id) [unique, name: 'uq_project_milestones_id_university']
  (id, project_id, university_id) [unique, name: 'uq_project_milestones_id_project_university']
  }
  checks {
    `completed_at IS NULL OR status = 'completed'` [name: 'ck_project_milestones_completed']
    `sequence_number > 0` [name: 'ck_project_milestones_sequence']
    `status IN ('pending', 'in_progress', 'submitted', 'approved', 'revision_requested', 'overdue', 'completed', 'cancelled')` [name: 'ck_project_milestones_status']
  }
}

Table project_participants {
